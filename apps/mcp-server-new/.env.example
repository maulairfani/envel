# --- App settings (dibaca pydantic-settings di src/config.py) ---
JWT_SECRET=change-me-to-a-random-32-char-string
AUTH_BASE_URL=http://auth-server:9000
MCP_BASE_URL=http://localhost:8000
MANAGED_DATABASE_URL=postgresql://envel:envel@postgres-managed:5432/envel_managed

# Shared secret untuk endpoint /internal/* — harus sama dengan INTERNAL_API_KEY di auth-server
INTERNAL_API_KEY=change-me-shared-secret-with-mcp

# --- Postgres service (dipakai docker-compose.yml) ---
POSTGRES_USER=envel
POSTGRES_PASSWORD=envel
POSTGRES_DB=envel_managed
