# ───── Auth / JWT ─────
# Shared HS256 secret — MUST be identical in mcp-server & agent.
# Generate: openssl rand -hex 32
JWT_SECRET=change-me

# Public base URL of this auth server (used in OAuth metadata + token `iss`).
# Prod: https://your-domain/auth
AUTH_BASE_URL=http://localhost:9000
TOKEN_TTL=3600

# ───── Encryption ─────
# Fernet key — encrypts each user's db_url at rest. Keep it stable.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_DATA_KEY=

# ───── Internal API (auth ↔ mcp) ─────
MCP_INTERNAL_URL=http://mcp-server:8000
# Shared secret — MUST be identical in mcp-server. Generate: openssl rand -hex 32
INTERNAL_API_KEY=change-me

# ───── Postgres (auth DB) ─────
# This .env is the single source: pydantic builds the connection URL from these,
# and the Postgres container is initialised from them. POSTGRES_HOST defaults to
# "postgres-auth" in code (override only if you move the DB).
POSTGRES_USER=envel
POSTGRES_PASSWORD=envel
POSTGRES_DB=envel_auth
