# Envel auth-server base URL (browser-facing for /authorize + server-side /token exchange)
AUTH_URL=http://localhost:9000

# LangGraph agent server base URL (used by the /api/lg proxy — slice 2).
# Use 127.0.0.1 (not localhost) for `langgraph dev` — it binds IPv4 only, and
# Node fetch may resolve localhost to IPv6 (::1) → ECONNREFUSED.
AGENT_URL=http://127.0.0.1:2024

# Envel MCP server (streamable-http) — read-path for dashboard pages (slice 4)
MCP_URL=http://127.0.0.1:8001/mcp
