# --- App settings (dibaca pydantic-settings di src/config.py) ---
JWT_SECRET=change-me-to-a-random-32-char-string
AUTH_BASE_URL=http://localhost:9000
DATABASE_URL=postgresql://envel:envel@postgres-auth:5432/envel_auth
TOKEN_TTL=3600

# Fernet key untuk encrypt db_url di tabel users.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_DATA_KEY=change-me-generate-fernet-key

# MCP internal API (untuk provisioning)
MCP_INTERNAL_URL=http://mcp-server:8000
INTERNAL_API_KEY=change-me-shared-secret-with-mcp

# --- Postgres service (dipakai docker-compose.yml) ---
POSTGRES_USER=envel
POSTGRES_PASSWORD=envel
POSTGRES_DB=envel_auth
