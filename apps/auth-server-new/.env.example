# ───── OAuth / JWT ─────
JWT_SECRET=change-me-to-a-random-32-char-string
AUTH_BASE_URL=http://localhost:9000
TOKEN_TTL=3600

# ───── Encryption ─────
# Fernet key (32-byte base64) untuk encrypt users.db_url_encrypted.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_DATA_KEY=

# ───── Internal API (auth ↔ mcp) ─────
MCP_INTERNAL_URL=http://mcp-server:8000
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=change-me-shared-secret-with-mcp

# ───── Postgres service (untuk docker-compose.yml) ─────
# DATABASE_URL di-compose dari sini lewat docker-compose.yml
POSTGRES_USER=envel
POSTGRES_PASSWORD=envel
POSTGRES_DB=envel_auth
