# ───── Auth / JWT ─────
# Shared HS256 secret — MUST be identical in auth-server & agent.
# Generate: openssl rand -hex 32
JWT_SECRET=change-me

# Auth server address for internal calls (/internal/db-url) — use the INTERNAL
# service address, not the public one (avoids hairpinning + exposing /internal).
AUTH_BASE_URL=http://auth-server:9000
# PUBLIC auth URL advertised in OAuth metadata to external MCP clients (must be
# reachable by them). Prod: https://auth.your-domain
AUTH_PUBLIC_URL=http://localhost:9000
# Public base URL of this MCP server (the OAuth "resource"). Prod subdomain
# recommended (root .well-known served cleanly): https://mcp.your-domain
MCP_BASE_URL=http://localhost:8001

# ───── Internal API (mcp ↔ auth) ─────
# MUST be identical in auth-server.
INTERNAL_API_KEY=change-me

# ───── Postgres (managed DB) ─────
# This .env is the single source: pydantic builds the connection URL from these,
# and the Postgres container is initialised from them. POSTGRES_HOST defaults to
# "postgres-managed" in code (override only if you move the DB).
POSTGRES_USER=envel
POSTGRES_PASSWORD=envel
POSTGRES_DB=envel_managed
