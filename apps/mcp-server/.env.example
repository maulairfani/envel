# ───── OAuth / JWT ─────
JWT_SECRET=change-me-to-a-random-32-char-string
AUTH_BASE_URL=http://auth-server:9000
MCP_BASE_URL=http://localhost:8000

# ───── Internal API (mcp ↔ auth) ─────
# Harus sama dengan INTERNAL_API_KEY di auth-server/.env
INTERNAL_API_KEY=change-me-shared-secret-with-auth

# ───── Postgres service (untuk docker-compose.yml) ─────
# MANAGED_DATABASE_URL di-compose dari sini lewat docker-compose.yml
POSTGRES_USER=envel
POSTGRES_PASSWORD=envel
POSTGRES_DB=envel_managed
