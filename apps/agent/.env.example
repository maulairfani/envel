# ───── LLM ─────
OPENAI_API_KEY=sk-...
# provider:model — swappable. Default model for Envel agent.
ENVEL_MODEL=openai:gpt-5.4-nano

# ───── LangSmith (REQUIRED for the containerized server) ─────
# The `langchain/langgraph-api` image is the licensed self-hosted server: it
# verifies a license on startup. A free LangSmith account key enables the
# Self-Hosted Lite tier (up to ~1M node executions/year). NOT needed for the
# local `langgraph dev` (in-memory) workflow.
LANGSMITH_API_KEY=

# ───── MCP server (tools/data) ─────
# Local dev (langgraph dev on host): MCP server published on host port 8001.
# In docker-compose, override to http://mcp-server:8000/mcp (internal network).
MCP_URL=http://localhost:8001/mcp

# ───── Auth (shared with auth-server & mcp-server) ─────
# Must match JWT_SECRET in apps/mcp-server/.env and apps/auth-server/.env.
# The agent verifies incoming JWTs locally (HS256) and forwards them to MCP.
JWT_SECRET=change-me-to-a-random-32-char-string

# Dev convenience: a signed JWT used as the MCP bearer when no per-request
# user token is set (i.e. when calling the graph without going through
# LangGraph custom auth). Leave empty in production.
ENVEL_DEV_TOKEN=
