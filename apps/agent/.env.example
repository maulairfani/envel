# ───── LLM ─────
OPENAI_API_KEY=sk-...
# provider:model — swappable.
ENVEL_MODEL=openai:gpt-5.4-nano

# ───── LangSmith (REQUIRED for the containerized server) ─────
# The langchain/langgraph-api image verifies a license on startup; a free
# LangSmith key enables the Self-Hosted Lite tier. NOT needed for `langgraph dev`.
LANGSMITH_API_KEY=
# Optional: send traces to LangSmith.
# LANGSMITH_TRACING=true

# ───── Auth ─────
# Shared HS256 secret — MUST be identical in auth-server & mcp-server. The agent
# verifies incoming JWTs locally (HS256) and forwards them to MCP per request.
JWT_SECRET=change-me
# Dev-only fallback bearer for MCP calls when there is no per-request user token
# (a JWT signed with JWT_SECRET, sub = an existing username). EMPTY in prod.
ENVEL_DEV_TOKEN=

# ───── MCP server ─────
# Host value for `langgraph dev`. In docker-compose this is overridden to the
# internal address http://mcp-server:8000/mcp.
MCP_URL=http://localhost:8001/mcp

# ───── Postgres (agent DB: chat history, checkpoints, long-term memory) ─────
# Init the agent's Postgres + build POSTGRES_URI (in compose). Managed by LangGraph.
POSTGRES_USER=envel
POSTGRES_PASSWORD=envel
POSTGRES_DB=envel_agent
